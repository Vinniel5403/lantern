# Backend runtime
APP_ENV=development
ASR_PROVIDER=typhoon_api
MAX_AUDIO_BYTES=1000000
WAKE_PHRASE=lantern

# Reserved for the Typhoon hosted adapter. Keep real values in an untracked .env.
TYPHOON_API_KEY=
TYPHOON_API_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_ASR_MODEL=typhoon-asr-realtime
TYPHOON_API_TIMEOUT_S=30

# Reserved for a local typhoon-asr deployment.
TYPHOON_SELF_HOST_URL=http://127.0.0.1:8001
